{
  "expo": {
    "name": "Juniper Onboarding",
    "slug": "juniper-onboarding",
    "version": "0.1.0",
    "scheme": "juniper-onboarding",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
