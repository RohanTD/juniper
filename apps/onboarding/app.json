{
  "expo": {
    "name": "Juniper Onboarding",
    "slug": "juniper-onboarding",
    "version": "0.1.0",
    "scheme": "juniper-onboarding",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rtdharia.juniper-onboarding"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
