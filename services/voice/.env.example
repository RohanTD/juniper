# Juniper voice service — environment variables (no secrets in this file)

# --- Auth for this service's own HTTP surface -------------------------------
# Bearer token Deepgram sends to /v1/chat/completions and the apps send to the
# preferences API (docs/CONTRACTS.md §1). Unset = auth disabled (dev only).
JUNIPER_API_TOKEN=

# --- Upstream credentials ---------------------------------------------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
TWILIO_AUTH_TOKEN=

# --- Public host ------------------------------------------------------------
# Scheme-less public hostname used to build the TwiML <Stream> URL and the
# Deepgram think-endpoint URL (e.g. an ngrok domain during development).
JUNIPER_PUBLIC_HOST=localhost:8000

# --- Medplum ----------------------------------------------------------------
MEDPLUM_BASE_URL=
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- App-level stores -------------------------------------------------------
JUNIPER_PREFERENCES_PATH=data/preferences.json
JUNIPER_CONTEXT_BRAIN_PATH=data/context_brain.json

# --- Terminology ------------------------------------------------------------
# Defaults to <repo root>/packages/terminology/terminology.json.
JUNIPER_TERMINOLOGY_PATH=

# --- FHIR attribution -------------------------------------------------------
# Medplum assigns its own UUID on create for every project — these are NOT the
# identifier slugs ("juniper-voice-agent"). Run medplum/scripts/apply.sh
# against your project; it prints the exact two lines to paste here.
JUNIPER_DEVICE_REFERENCE=
JUNIPER_ORGANIZATION_REFERENCE=

# --- Budgets ----------------------------------------------------------------
JUNIPER_EHR_BRIEF_TOKEN_BUDGET=2500

# --- Model roster (docs/CONTRACTS.md §5; env-overridable) -------------------
JUNIPER_MODEL_COMPANION=claude-sonnet-5
JUNIPER_MODEL_COMPASSION=claude-haiku-4-5-20251001
JUNIPER_MODEL_URGENCY=claude-haiku-4-5-20251001
JUNIPER_MODEL_ADVISOR=claude-sonnet-5
JUNIPER_MODEL_DOCUMENTATION=claude-opus-5

# --- Deepgram voice models --------------------------------------------------
JUNIPER_DEEPGRAM_LISTEN_MODEL=nova-3
JUNIPER_DEEPGRAM_SPEAK_MODEL=aura-2-thalia-en


# --- Context mode (docs/MOSS_PLAN.md) ---------------------------------------
# "brief" (default): compiled EHR brief + Context Brain digest — the tested
# fallback. "moss": semantic retrieval (chart + memories indexes + live-call
# session) with the pinned core header. Requires MOSS_PROJECT_ID/KEY.
JUNIPER_CONTEXT_MODE=brief
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# moss-mediumlm (accuracy) or moss-minilm (speed). HARDENS at first index
# build — changing it later is a re-embed migration (purge + rebuild).
JUNIPER_MOSS_MODEL=moss-mediumlm
JUNIPER_MOSS_INDEX_PREFIX=juniper
JUNIPER_MOSS_QUERY_TIMEOUT=0.15
JUNIPER_MOSS_HYDRATE_TIMEOUT=2.0
# Delta upserts never remove deleted FHIR resources; every Nth call the chart
# index is rebuilt from scratch (off the call path). 0 disables.
JUNIPER_MOSS_FULL_REBUILD_EVERY=20
JUNIPER_RETRIEVAL_STATE_PATH=data/retrieval_state.json
