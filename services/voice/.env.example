# Juniper voice service — environment variables (no secrets in this file)

# --- Auth for this service's own HTTP surface -------------------------------
# Bearer token Deepgram sends to /v1/chat/completions and the apps send to the
# preferences API (docs/CONTRACTS.md §1). Unset = auth disabled (dev only).
JUNIPER_API_TOKEN=

# --- Upstream credentials ---------------------------------------------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
TWILIO_AUTH_TOKEN=

# --- Public host ------------------------------------------------------------
# Scheme-less public hostname used to build the TwiML <Stream> URL and the
# Deepgram think-endpoint URL (e.g. an ngrok domain during development).
JUNIPER_PUBLIC_HOST=localhost:8000

# --- Browser origins --------------------------------------------------------
# The family app is a WEB dashboard, so its calls here are cross-origin and a
# browser drops them unless the origin is allowed. Comma-separated; unset keeps
# the Expo dev defaults (localhost 8081/8082/19006); an explicitly empty value
# disables CORS entirely. Never "*".
JUNIPER_CORS_ORIGINS=

# --- Medplum ----------------------------------------------------------------
MEDPLUM_BASE_URL=
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# --- App-level stores -------------------------------------------------------
JUNIPER_PREFERENCES_PATH=data/preferences.json
JUNIPER_CONTEXT_BRAIN_PATH=data/context_brain.json
# Family-side "I've seen this alert" state. NOT Task.status — that belongs to
# the care team the escalation Task is addressed to.
JUNIPER_ALERT_ACKNOWLEDGEMENTS_PATH=data/alert_acknowledgements.json

# --- Terminology ------------------------------------------------------------
# Defaults to <repo root>/packages/terminology/terminology.json.
JUNIPER_TERMINOLOGY_PATH=

# --- FHIR attribution -------------------------------------------------------
# Medplum assigns its own UUID on create for every project — these are NOT the
# identifier slugs ("juniper-voice-agent"). Run medplum/scripts/apply.sh
# against your project; it prints the exact two lines to paste here.
JUNIPER_DEVICE_REFERENCE=
JUNIPER_ORGANIZATION_REFERENCE=

# --- Budgets ----------------------------------------------------------------
JUNIPER_EHR_BRIEF_TOKEN_BUDGET=2500

# --- Turn composition -------------------------------------------------------
# false collapses the turn to a SINGLE LLM call. Disabling urgency removes the
# real-time escalation path (no care-team Task); disabling compassion removes
# the INDEPENDENT check on condescension + negative constraints (the Companion
# is still instructed on both). Default true; set false only for demos.
JUNIPER_URGENCY_FILTER=true
JUNIPER_COMPASSION_FILTER=true

# --- Model roster (docs/CONTRACTS.md §5; env-overridable) -------------------
JUNIPER_MODEL_COMPANION=claude-haiku-4-5-20251001
JUNIPER_MODEL_COMPASSION=llama-3.3-70b-versatile
JUNIPER_MODEL_URGENCY=llama-3.3-70b-versatile
JUNIPER_MODEL_ADVISOR=llama-3.3-70b-versatile
JUNIPER_MODEL_DOCUMENTATION=claude-opus-5

# --- Deepgram voice models --------------------------------------------------
JUNIPER_DEEPGRAM_LISTEN_MODEL=flux-general-en
JUNIPER_DEEPGRAM_SPEAK_MODEL=aura-2-phoebe-en
# End-of-turn tuning (Flux only). Higher threshold + longer timeout than
# Deepgram's defaults (0.7 / 5000) so a slower speaker gathering their thought
# is not cut off mid-sentence.
JUNIPER_DEEPGRAM_EOT_THRESHOLD=0.85
JUNIPER_DEEPGRAM_EOT_TIMEOUT_MS=8000


# --- Context mode (docs/MOSS_PLAN.md) ---------------------------------------
# "brief"  (default): compiled EHR brief + Context Brain digest — the tested
#                     fallback, and where the fail-soft path lands.
# "shadow" (Phase A): retrieval runs and is measured/logged but reaches NO
#                     prompt; prompts stay byte-identical to brief mode.
# "moss"   (Phase B): retrieval injected, pinned core header replaces the bulk
#                     brief. Requires MOSS_PROJECT_ID/KEY.
JUNIPER_CONTEXT_MODE=brief
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# moss-mediumlm (accuracy) or moss-minilm (speed). HARDENS at first index
# build — changing it later is a re-embed migration (purge + rebuild).
JUNIPER_MOSS_MODEL=moss-mediumlm
JUNIPER_MOSS_INDEX_PREFIX=juniper
JUNIPER_MOSS_QUERY_TIMEOUT=0.15
JUNIPER_MOSS_HYDRATE_TIMEOUT=2.0
# Retrieval tuning — the Phase A gates (alpha, top_k) are meant to be runnable
# without a redeploy.
JUNIPER_MOSS_ALPHA=0.7
JUNIPER_MOSS_TOP_K_CHART=4
JUNIPER_MOSS_TOP_K_MEMORIES=3
JUNIPER_MOSS_TOP_K_SESSION=3
# Delta upserts never remove deleted FHIR resources; every Nth call the chart
# index is rebuilt from scratch (off the call path). 0 disables.
JUNIPER_MOSS_FULL_REBUILD_EVERY=20
JUNIPER_RETRIEVAL_STATE_PATH=data/retrieval_state.json

# --- Groq (critical-path LLM: Companion + filters) --------------------------
# Model name selects the provider: "claude-*" -> Anthropic, anything else ->
# Groq. Override any single role below to move it between providers.
GROQ_API_KEY=
