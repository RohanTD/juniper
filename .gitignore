# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
npm-debug.log*

# Env / secrets — never commit credentials
.env
.env.*
!.env.example

# Local tooling
.claude/settings.local.json

# App-level stores and scratch output
*.local.json
scratch/
services/voice/data/

# Expo Continuous Native Generation output — regenerated by `expo prebuild`
# / `expo run:ios`. Committing it would fork the native project from app.json
# and app plugins, which is the thing CNG exists to prevent.
apps/*/ios/
apps/*/android/
